---
const { base = '' } = Astro.props;
---

<header class="site-header">
  <nav id="navigation-principale" aria-label="Navigation principale">
    <a href={`${base}#accueil`}>Accueil</a>
    <a href={`${base}#a-propos`}>À propos</a>
    <a href={`${base}#projets`}>Projets</a>
    <a href={`${base}#competences`}>Compétences</a>
    <a href={`${base}#contact`}>Contact</a>
  </nav>
</header>

<style>
  .site-header { position: fixed; z-index: 20; inset: 0; width: 100%; height: 0; }
  nav { display: flex; width: 40em; height: 3em; align-items: center; justify-content: center; gap: 2rem; margin: 20px auto; padding: .5em 2em; border: 1px solid rgba(255,255,255,.3); border-radius: 16px; background: rgba(206,206,206,.5); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  nav a { color: var(--ink); font-family: var(--font-display); font-size: 16px; font-weight: 500; text-align: center; text-decoration: none; text-transform: uppercase; white-space: nowrap; }
  nav a { position: relative; }
  nav a::after { position: absolute; bottom: -.42rem; left: 50%; width: 5px; height: 5px; content: ''; transform: translate(-50%, 3px) scale(0); border-radius: 50%; background: var(--ink); opacity: 0; transition: transform .25s ease, opacity .25s ease; }
  nav a:hover::after, nav a:focus-visible::after { transform: translate(-50%, 0) scale(1); opacity: 1; }

  @media (max-width: 680px) {
    nav { width: calc(100% - 1.5rem); height: 3em; gap: clamp(.55rem, 3vw, 1rem); padding: .5em .75em; overflow-x: auto; }
    nav a { font-size: clamp(.58rem, 2.3vw, .75rem); }
  }
</style>
