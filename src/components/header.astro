---
const { base = '' } = Astro.props;
---

<header class="site-header">
  <div class="mobile-bar">
    <a class="mobile-brand" href={`${base}#accueil`} aria-label="Retour à l’accueil">LV</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation-principale" aria-label="Ouvrir le menu">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line class="menu-toggle__line menu-toggle__line--top" x1="5" y1="9" x2="19" y2="9"></line>
        <line class="menu-toggle__line menu-toggle__line--bottom" x1="5" y1="15" x2="19" y2="15"></line>
      </svg>
    </button>
  </div>

  <nav id="navigation-principale" aria-label="Navigation principale">
    <a data-index="01" href={`${base}#accueil`}>Accueil</a>
    <a data-index="02" href={`${base}#a-propos`}>À propos</a>
    <a data-index="03" href={`${base}#projets`}>Projets</a>
    <a data-index="04" href={`${base}#competences`}>Compétences</a>
    <a data-index="05" href={`${base}#contact`}>Contact</a>
  </nav>
</header>

<script>
  import gsap from 'gsap';

  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');
  const nav = header?.querySelector('#navigation-principale');
  const links = nav ? [...nav.querySelectorAll('a')] : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const duration = reduceMotion ? 0 : .65;
  let isOpen = false;

  const menuTimeline = gsap.timeline({
    paused: true,
    defaults: { ease: 'power3.inOut' },
    onStart: () => {
      gsap.set(nav, { visibility: 'visible', pointerEvents: 'auto' });
    },
    onReverseComplete: () => {
      gsap.set(nav, { visibility: 'hidden', pointerEvents: 'none' });
    },
  });

  menuTimeline
    .fromTo(nav, { clipPath: 'inset(0 0 100% 0 round 22px)' }, { clipPath: 'inset(0 0 0% 0 round 22px)', duration, immediateRender: false }, 0)
    .fromTo(links, { yPercent: 115, opacity: 0 }, { yPercent: 0, opacity: 1, duration: reduceMotion ? 0 : .55, stagger: reduceMotion ? 0 : .06, immediateRender: false }, reduceMotion ? 0 : .18)
    .to('.menu-toggle__line--top', { attr: { x1: 6, y1: 6, x2: 18, y2: 18 }, duration: reduceMotion ? 0 : .35 }, 0)
    .to('.menu-toggle__line--bottom', { attr: { x1: 18, y1: 6, x2: 6, y2: 18 }, duration: reduceMotion ? 0 : .35 }, 0);

  if (window.innerWidth > 680) {
    gsap.set(nav, { clearProps: 'visibility,pointerEvents,clipPath' });
    gsap.set(links, { clearProps: 'transform,opacity' });
  }

  const setMenu = (open, restoreFocus = false) => {
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    isOpen = open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.body.classList.toggle('menu-is-open', open);

    if (open) {
      menuTimeline.play();
      window.setTimeout(() => links[0]?.focus(), reduceMotion ? 0 : 450);
    } else {
      menuTimeline.reverse();
      if (restoreFocus) toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenu(!isOpen));
  links.forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen) setMenu(false, true);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 680) {
      isOpen = false;
      document.body.classList.remove('menu-is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Ouvrir le menu');
      menuTimeline.pause(0);
      gsap.set(nav, { clearProps: 'visibility,pointerEvents,clipPath' });
      gsap.set(links, { clearProps: 'transform,opacity' });
      gsap.set(['.menu-toggle__line--top', '.menu-toggle__line--bottom'], { clearProps: 'transform' });
    }
  });
</script>

<style>
  .site-header {
    position: static;
    width: 100%;
    pointer-events: none;
  }

  .mobile-bar {
    display: none;
  }

  nav {
    position: fixed;
    z-index: 20;
    top: 20px;
    left: 50%;
    display: flex;
    width: 40em;
    height: 3em;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin: 0;
    padding: .5em 2em;
    border: 1px solid rgba(255, 255, 255, .3);
    border-radius: 16px;
    background: rgba(206, 206, 206, .5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transform: translateX(-50%);
    pointer-events: auto;
  }

  nav a {
    position: relative;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  nav a::after {
    position: absolute;
    bottom: -.42rem;
    left: 50%;
    width: 5px;
    height: 5px;
    content: '';
    transform: translate(-50%, 3px) scale(0);
    border-radius: 50%;
    background: var(--ink);
    opacity: 0;
    transition: transform .25s ease, opacity .25s ease;
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: translate(-50%, 0) scale(1);
    opacity: 1;
  }

  @media (max-width: 680px) {
    :global(body.menu-is-open) {
      overflow: hidden;
    }

    .site-header {
      position: static;
      pointer-events: none;
    }

    .mobile-bar {
      position: fixed;
      z-index: 22;
      top: .75rem;
      left: 50%;
      display: flex;
      width: calc(100% - 1.5rem);
      height: 3.75rem;
      align-items: center;
      justify-content: space-between;
      margin: 0;
      padding: .4rem .45rem .4rem 1.2rem;
      border: 1px solid rgba(255, 255, 255, .42);
      border-radius: 18px;
      background: rgba(206, 211, 207, .72);
      box-shadow: 0 10px 28px rgba(15, 47, 27, .08);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transform: translateX(-50%);
      pointer-events: auto;
    }

    .mobile-brand {
      color: var(--green);
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 750;
      letter-spacing: -.04em;
      text-decoration: none;
    }

    .menu-toggle {
      position: relative;
      display: grid;
      width: 2.85rem;
      height: 2.85rem;
      place-items: center;
      border: 0;
      border-radius: 14px;
      color: var(--ink);
      background: rgba(255, 255, 255, .55);
      cursor: pointer;
      overflow: visible;
    }

    .menu-toggle svg {
      display: block;
      width: 1.55rem;
      height: 1.55rem;
      overflow: visible;
    }

    .menu-toggle__line {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
    }

    nav {
      position: fixed;
      z-index: 21;
      inset: .75rem;
      display: flex;
      width: auto;
      height: auto;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-end;
      gap: 0;
      margin: 0;
      padding: 6.25rem 1.25rem 1.5rem;
      border-radius: 22px;
      background:
        radial-gradient(circle at 18% 12%, rgba(225, 241, 228, .95), transparent 44%),
        linear-gradient(145deg, rgba(240, 244, 240, .97), rgba(222, 231, 235, .97));
      box-shadow: 0 24px 70px rgba(8, 28, 16, .18);
      visibility: hidden;
      transform: none;
      pointer-events: none;
      overflow: hidden;
    }

    nav::before {
      position: absolute;
      top: 5.2rem;
      right: 1.35rem;
      width: .6rem;
      height: .6rem;
      content: '';
      border-radius: 50%;
      background: var(--green);
    }

    nav a {
      display: grid;
      min-height: clamp(4rem, 14vw, 5.25rem);
      align-items: center;
      grid-template-columns: 2rem 1fr;
      overflow: hidden;
      border-bottom: 1px solid rgba(8, 11, 9, .2);
      font-size: clamp(1.9rem, 9vw, 3.3rem);
      font-weight: 600;
      letter-spacing: -.045em;
      line-height: 1;
      text-align: left;
    }

    nav a::before {
      align-self: start;
      padding-top: 1.1rem;
      content: attr(data-index);
      font-family: var(--font-body);
      font-size: .62rem;
      font-weight: 600;
      letter-spacing: .08em;
    }

    nav a::after {
      display: none;
    }

    nav a:hover,
    nav a:focus-visible {
      color: var(--green);
    }
  }

</style>
