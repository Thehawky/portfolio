---
import Header from '../../components/header.astro';
import ProjectCard from '../../components/projectCard.astro';
import { getCategoryLabel, getProjectCategories, getProjects } from '../../lib/projects';
import '../../styles/global.css';

const projects = await getProjects();
const categories = [
  { label: 'Tout', value: 'tout' },
  ...getProjectCategories(projects).map((value) => ({ label: getCategoryLabel(value), value })),
];

const categoryIcons: Record<string, string> = {
  tout: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/>',
  graphisme: '<path d="M12 3 5 7v10l7 4 7-4V7l-7-4Z"/><path d="m5 7 7 4 7-4M12 11v10"/>',
  'developpement-web': '<path d="m9 6-6 6 6 6M15 6l6 6-6 6M14 3l-4 18"/>',
  marketing: '<path d="M4 13v-2l11-5v12L4 13Z"/><path d="M15 9c3 0 5 1 6 3-1 2-3 3-6 3M6 14l1 6h4l-2-5"/>',
  photo: '<rect x="3" y="6" width="18" height="14" rx="2"/><path d="m8 6 1.5-3h5L16 6"/><circle cx="12" cy="13" r="4"/>',
  video: '<rect x="3" y="5" width="14" height="14" rx="2"/><path d="m17 10 4-3v10l-4-3v-4Z"/>',
  autres: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 12h8M12 8v8"/>',
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Galerie des projets de Luca Vuille." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Galerie — Luca Vuille</title>
  </head>
  <body class="gallery-page">
    <Header base="/" />
    <div class="page-grid" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>

    <main class="gallery-main">
      <header class="gallery-heading">
        <h1>Galerie</h1>
        <div class="gallery-controls">
          <div class="category-filter" role="group" aria-label="Filtrer les projets par catégorie">
            {categories.map(({ label, value }) => (
              <button type="button" data-filter={value} aria-label={label} title={label} aria-pressed={value === 'tout' ? 'true' : 'false'}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={categoryIcons[value] ?? categoryIcons.autres}></svg>
                <span>{label}</span>
              </button>
            ))}
          </div>

          <div class="search-control">
            <label for="project-search">Rechercher un projet</label>
            <input id="project-search" type="search" placeholder="Rechercher…" autocomplete="off" />
            <button class="search-toggle" type="button" aria-label="Ouvrir la recherche" aria-expanded="false" aria-controls="project-search">
              <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
            </button>
          </div>
        </div>
      </header>

      <section class="projects-mosaic" aria-label="Tous les projets" aria-live="polite">
        {projects.map((project) => {
          const ratio = project.cover?.layoutRatio ?? 1.45;
          const basis = Math.min(34, Math.max(14, ratio * 16));
          const maximum = Math.min(42, Math.max(22, ratio * 28));
          return (
            <article
              class="gallery-item"
              style={`--item-ratio:${ratio};--item-basis:${basis}rem;--item-maximum:${maximum}rem`}
              data-project
              data-categories={project.category}
              data-title={`${project.entry.data.title} ${project.entry.data.type} ${project.entry.data.skills.join(' ')}`.toLocaleLowerCase('fr')}
            >
              <ProjectCard
                title={project.entry.data.title}
                category={project.entry.data.type}
                href={project.url}
                image={project.cover?.src}
                ratio={ratio}
                tone={project.tone}
                layout="mosaic"
              />
            </article>
          );
        })}
      </section>
      <p class="gallery-empty" hidden>Aucun projet ne correspond à cette recherche.</p>
    </main>

    <script is:inline>
      (() => {
        const buttons = [...document.querySelectorAll('[data-filter]')];
        const projects = [...document.querySelectorAll('[data-project]')];
        const searchInput = document.querySelector('#project-search');
        const emptyMessage = document.querySelector('.gallery-empty');
        const normalize = (value) => value.toLocaleLowerCase('fr').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const requestedFilter = new URLSearchParams(window.location.search).get('filtre');
        let activeFilter = buttons.some((button) => button.dataset.filter === requestedFilter) ? requestedFilter : 'tout';

        const applyFilters = (animate = true) => {
          const query = searchInput instanceof HTMLInputElement ? normalize(searchInput.value.trim()) : '';
          let visibleCount = 0;

          projects.forEach((project) => {
            const categories = (project.dataset.categories ?? '').split(' ');
            const title = normalize(project.dataset.title ?? '');
            const visible = (activeFilter === 'tout' || categories.includes(activeFilter)) && (!query || title.includes(query));
            project.hidden = !visible;
            project.style.display = visible ? '' : 'none';
            if (visible) {
              visibleCount += 1;
              if (animate && typeof project.animate === 'function') {
                project.animate(
                  [{ opacity: 0, transform: 'translateY(18px)' }, { opacity: 1, transform: 'translateY(0)' }],
                  { duration: 400, easing: 'cubic-bezier(.2,.8,.2,1)' },
                );
              }
            }
          });

          if (emptyMessage instanceof HTMLElement) emptyMessage.hidden = visibleCount !== 0;
        };

        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.filter === activeFilter));
          button.addEventListener('click', () => {
            activeFilter = button.dataset.filter ?? 'tout';
            buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
            const url = new URL(window.location.href);
            activeFilter === 'tout' ? url.searchParams.delete('filtre') : url.searchParams.set('filtre', activeFilter);
            history.replaceState({}, '', url);
            applyFilters();
          });
        });

        searchInput?.addEventListener('input', () => applyFilters());
        applyFilters(false);
      })();
    </script>

    <script>
      import gsap from 'gsap';

      const search = document.querySelector('#project-search');
      const searchControl = document.querySelector('.search-control');
      const searchToggle = document.querySelector('.search-toggle');
      const categoryFilter = document.querySelector('.category-filter');
      let searchIsOpen = false;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const openSearch = () => {
        if (searchIsOpen || !(searchControl instanceof HTMLElement) || !(categoryFilter instanceof HTMLElement)) return;
        searchIsOpen = true;
        searchToggle?.setAttribute('aria-expanded', 'true');
        gsap.killTweensOf([searchControl, categoryFilter]);
        gsap.to(categoryFilter, {
          opacity: 0,
          y: -8,
          duration: reducedMotion ? 0 : .2,
          ease: 'power2.in',
          onComplete: () => {
            gsap.set(categoryFilter, { visibility: 'hidden' });
            searchControl.classList.add('is-open');
            gsap.fromTo(searchControl,
              { opacity: 0, scaleX: .16, transformOrigin: 'right center' },
              { opacity: 1, scaleX: 1, duration: reducedMotion ? 0 : .38, ease: 'power3.out', onComplete: () => search instanceof HTMLInputElement && search.focus() },
            );
          },
        });
      };

      const closeSearch = () => {
        if (!searchIsOpen || !(searchControl instanceof HTMLElement) || !(categoryFilter instanceof HTMLElement)) return;
        searchIsOpen = false;
        searchToggle?.setAttribute('aria-expanded', 'false');
        if (search instanceof HTMLInputElement) search.blur();
        gsap.killTweensOf([searchControl, categoryFilter]);
        gsap.to(searchControl, {
          opacity: 0,
          scaleX: .16,
          transformOrigin: 'right center',
          duration: reducedMotion ? 0 : .25,
          ease: 'power2.in',
          onComplete: () => {
            searchControl.classList.remove('is-open');
            gsap.set(searchControl, { clearProps: 'opacity,transform,transformOrigin' });
            gsap.set(categoryFilter, { visibility: 'visible' });
            gsap.fromTo(categoryFilter, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: reducedMotion ? 0 : .32, ease: 'power3.out', clearProps: 'opacity,transform,visibility' });
          },
        });
      };

      searchToggle?.addEventListener('click', () => searchIsOpen ? closeSearch() : openSearch());

      document.addEventListener('pointerdown', (event) => {
        if (searchControl instanceof HTMLElement && !searchControl.contains(event.target)) closeSearch();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeSearch();
      });

      if (!reducedMotion) {
        gsap.from('.gallery-heading > h1', { yPercent: 80, opacity: 0, duration: .9, ease: 'power3.out' });
        gsap.from('.gallery-controls', { y: 22, opacity: 0, duration: .7, delay: .2, ease: 'power3.out' });
        gsap.from('.gallery-item:not([hidden])', { y: 45, opacity: 0, duration: .65, stagger: .06, delay: .25, ease: 'power3.out' });
      }
    </script>
  </body>
</html>

<style>
  .gallery-page { min-height:100vh; background:radial-gradient(circle at 9% 18%,rgba(216,239,222,.8),transparent 34%),radial-gradient(circle at 90% 13%,rgba(218,230,238,.68),transparent 40%),#fafcfb; }
  .gallery-main { padding:clamp(9rem,15vw,15rem) var(--gutter) clamp(6rem,10vw,10rem); }
  .gallery-heading { margin-bottom:clamp(7rem,14vw,14rem); }
  .gallery-heading h1 { overflow:hidden; font-family:var(--font-display); font-size:clamp(4.5rem,9vw,8.5rem); font-weight:700; letter-spacing:-.055em; line-height:.9; text-transform:uppercase; }
  .gallery-controls { position:relative; --control-height:3.25rem; display:flex; align-items:center; gap:.75rem; margin-top:clamp(2rem,4vw,3.5rem); }
  .category-filter { position:relative; z-index:2; display:flex; height:var(--control-height); align-items:center; gap:.15rem; padding:.35rem .55rem; border-radius:16px; background:rgba(206,206,206,.58); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); pointer-events:auto; }
  .category-filter button { position:relative; z-index:1; display:grid; place-items:center; padding:.45rem .65rem; border:0; border-radius:10px; color:var(--ink); background:transparent; font-family:var(--font-body); font-size:.78rem; font-weight:500; cursor:pointer; white-space:nowrap; pointer-events:auto; transition:color .25s ease,background .25s ease; }
  .category-filter button svg { display:none; width:1.3rem; height:1.3rem; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .category-filter button:hover { background:rgba(255,255,255,.45); }
  .category-filter button[aria-pressed='true'] { color:white; background:var(--green); }
  .search-control { position:relative; z-index:1; display:flex; width:var(--control-height); height:var(--control-height); align-items:center; flex-direction:row-reverse; border-radius:16px; background:rgba(206,206,206,.58); overflow:hidden; transition:width .35s ease; }
  .search-control.is-open { position:absolute; z-index:4; inset:0; width:100%; height:100%; border:1px solid rgba(255,255,255,.3); background:rgba(206,206,206,.5); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); }
  .search-control label { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
  .search-control input { width:0; min-width:0; padding:0; border:0; outline:0; background:transparent; font:inherit; opacity:0; transition:width .35s ease,padding .35s ease,opacity .2s ease; }
  .search-control.is-open input { width:calc(100% - var(--control-height)); height:100%; padding:0 .75rem 0 1rem; opacity:1; }
  .search-toggle { display:grid; width:var(--control-height); height:var(--control-height); flex:0 0 auto; place-items:center; border:0; background:transparent; cursor:pointer; }
  .search-toggle svg { width:1.35rem; fill:none; stroke:currentColor; stroke-linecap:round; stroke-width:1.8; }
  .projects-mosaic { display:flex; width:100%; flex-wrap:wrap; align-items:flex-start; justify-content:center; gap:clamp(1rem,2vw,1.8rem); }
  .gallery-item { width:auto; min-width:min(100%,14rem); max-width:min(100%,var(--item-maximum)); flex:var(--item-ratio) 1 var(--item-basis); aspect-ratio:var(--item-ratio); }
  .gallery-item[hidden] { display:none; }
  .gallery-empty { padding:6rem 0; color:rgba(8,11,9,.58); font-size:1.1rem; text-align:center; }

  @media (max-width:900px) {
    .gallery-controls { align-items:center; flex-direction:row; gap:.5rem; }
    .category-filter { width:auto; min-width:0; height:var(--control-height); flex:1 1 auto; gap:.1rem; padding:.3rem; overflow:visible; }
    .category-filter button { min-width:0; flex:1 1 0; padding:.35rem; }
    .category-filter button span { display:none; }
    .category-filter button svg { display:block; }
    .search-control { flex:0 0 var(--control-height); align-self:flex-start; flex-direction:row; }
    .gallery-item { min-width:min(100%,12rem); flex-basis:min(42%,var(--item-basis)); }
  }

  @media (max-width:580px) {
    .gallery-main { padding-top:8rem; }
    .gallery-heading { margin-bottom:5rem; }
    .gallery-controls { --control-height:3rem; }
    .category-filter button svg { width:1.15rem; height:1.15rem; }
    .gallery-item { width:100%; min-width:100%; max-width:100%; flex-basis:100%; aspect-ratio:var(--item-ratio); }
  }

</style>
