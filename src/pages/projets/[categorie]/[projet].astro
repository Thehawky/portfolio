---
import type { GetStaticPaths } from 'astro';
import { getProjects, slugify, type ProjectRecord } from '../../../lib/projects';
import '../../../styles/global.css';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { categorie: project.category, projet: project.slug },
    props: {
      project,
      nextProject: projects[(index + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

type Props = {
  project: ProjectRecord;
  nextProject: ProjectRecord;
};

const { project, nextProject } = Astro.props as Props;
const { title, type, description, skills } = project.entry.data;
const descriptionParagraphs = description.split(/\n\s*\n/).filter(Boolean);
const metaDescription = description.replace(/\s+/g, ' ').trim();
const projectImages = project.images.length > 0
  ? project.images.map((src, index) => ({
      src,
      number: String(index + 1).padStart(2, '0'),
      label: decodeURIComponent(src.split('/').at(-1) ?? `Image ${index + 1}`).replace(/\.[^.]+$/, ''),
    }))
  : [{ src: null, number: '01', label: 'Visuel à venir' }];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Luca Vuille</title>
  </head>
  <body class="project-page">
    <div class="page-grid" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>

    <header class="project-nav">
      <a href="/projets"><span aria-hidden="true">←</span> Voir les projets</a>
    </header>

    <main>
      <section class="project-intro" aria-labelledby="project-title">
        <div class="project-title-wrap">
          <h1 id="project-title">{title}</h1>
          <p>{type}</p>
        </div>

        <div class="project-about">
          <h2>À propos</h2>
          {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="project-gallery" aria-label={`Images du projet ${title}`}>
        <div class="project-gallery__track" tabindex="0">
          {projectImages.map((image, index) => (
            <button class={`project-visual project-visual--${project.tone}`} type="button" data-gallery-item data-index={index} aria-label={`Agrandir : ${image.label}`}>
              {image.src
                ? <img src={image.src} alt={`${title} — ${image.label}`} loading={index === 0 ? 'eager' : 'lazy'} />
                : <span aria-hidden="true">{image.number}</span>}
            </button>
          ))}
        </div>
      </section>

      <section class="project-skills" aria-labelledby="skills-title">
        <h2 id="skills-title">Compétences</h2>
        {skills.length > 0 ? (
          <div class="project-skills__list">
            {skills.map((skill) => (
              <a href={`/projets?filtre=${slugify(skill)}`}>
                <span>{skill}</span><span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : <p class="project-skills__empty">Compétences à venir.</p>}
      </section>

      <a class="next-project" href={nextProject.url} aria-label={`Projet suivant : ${nextProject.entry.data.title}`}>
        <span><small>Projet suivant</small><strong>{nextProject.entry.data.title}</strong></span>
        <span class="next-project__arrow" aria-hidden="true">↗</span>
      </a>
    </main>

    <dialog class="lightbox" aria-label={`Aperçu agrandi du projet ${title}`}>
      <button class="lightbox__close" type="button" aria-label="Fermer l’aperçu">×</button>
      <button class="lightbox__previous" type="button" aria-label="Image précédente">←</button>
      <div class={`lightbox__visual project-visual--${project.tone}`}>
        <img class="lightbox__image" alt="" />
        <span class="lightbox__fallback" aria-hidden="true">01</span>
      </div>
      <button class="lightbox__next" type="button" aria-label="Image suivante">→</button>
      <p class="lightbox__caption"></p>
    </dialog>

    <script define:vars={{ projectImages, title }}>
      const dialog = document.querySelector('.lightbox');
      const imageElement = dialog?.querySelector('.lightbox__image');
      const fallback = dialog?.querySelector('.lightbox__fallback');
      const caption = dialog?.querySelector('.lightbox__caption');
      const items = [...document.querySelectorAll('[data-gallery-item]')];
      let currentIndex = 0;

      const showImage = (index) => {
        currentIndex = (index + projectImages.length) % projectImages.length;
        const image = projectImages[currentIndex];
        if (imageElement instanceof HTMLImageElement) {
          imageElement.hidden = !image.src;
          imageElement.src = image.src ?? '';
          imageElement.alt = image.src ? `${title} — ${image.label}` : '';
        }
        if (fallback instanceof HTMLElement) {
          fallback.hidden = Boolean(image.src);
          fallback.textContent = image.number;
        }
        if (caption) caption.textContent = image.label;
      };

      items.forEach((item, index) => {
        item.addEventListener('click', () => {
          showImage(index);
          dialog?.showModal();
        });
      });

      dialog?.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
      dialog?.querySelector('.lightbox__previous')?.addEventListener('click', () => showImage(currentIndex - 1));
      dialog?.querySelector('.lightbox__next')?.addEventListener('click', () => showImage(currentIndex + 1));
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      document.addEventListener('keydown', (event) => {
        if (!dialog?.open) return;
        if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
        if (event.key === 'ArrowRight') showImage(currentIndex + 1);
      });
    </script>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.from('.project-title-wrap > *', { yPercent: 100, opacity: 0, duration: .9, stagger: .08, ease: 'power3.out' });
        gsap.from('.project-about', { y: 45, opacity: 0, duration: .9, delay: .3, ease: 'power3.out' });
        gsap.fromTo('.project-visual',
          { y: 30, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: .65,
            stagger: .07,
            ease: 'power3.out',
            force3D: true,
            clearProps: 'transform,opacity,visibility,willChange',
            scrollTrigger: { trigger: '.project-gallery', start: 'top 88%', once: true },
          },
        );
        gsap.from('.project-skills__list a', { y: 28, opacity: 0, duration: .55, stagger: .08, ease: 'power2.out', scrollTrigger: { trigger: '.project-skills', start: 'top 78%', once: true } });
      }
    </script>
  </body>
</html>

<style>
  .project-page { background:radial-gradient(circle at 12% 28%,rgba(216,239,222,.8),transparent 38%),radial-gradient(circle at 88% 18%,rgba(218,230,238,.65),transparent 42%),#fafcfb; }
  .project-nav { position:fixed; z-index:20; top:1.6rem; left:50%; transform:translateX(-50%); }
  .project-nav a { display:flex; width:clamp(20rem,34vw,32rem); height:3.2rem; align-items:center; justify-content:center; gap:.75rem; border:1px solid rgba(255,255,255,.35); border-radius:16px; color:var(--ink); background:rgba(206,206,206,.58); font-family:var(--font-display); font-size:.78rem; font-weight:600; text-decoration:none; text-transform:uppercase; backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); }
  .project-nav a>span { font-size:1.3rem; transition:transform .3s ease; }
  .project-nav a:hover>span { transform:translateX(-.35rem); }
  .project-intro { display:grid; min-height:52rem; grid-template-columns:1fr 1fr; align-items:start; gap:4rem; padding:clamp(7.5rem,12vw,11rem) var(--gutter) 5rem; }
  .project-title-wrap { min-width:0; }
  .project-title-wrap h1 { overflow-wrap:anywhere; font-family:var(--font-display); font-size:clamp(4.5rem,8.5vw,8rem); font-weight:700; letter-spacing:-.06em; line-height:.85; text-transform:uppercase; }
  .project-title-wrap p { margin-top:.7rem; font-size:.8rem; font-weight:650; text-transform:uppercase; }
  .project-about { align-self:center; max-width:31rem; margin-top:8rem; }
  .project-about h2 { margin-bottom:1.1rem; font-family:var(--font-display); font-size:clamp(1.5rem,2.2vw,2rem); text-transform:uppercase; }
  .project-about p { font-size:clamp(1rem,1.25vw,1.12rem); line-height:1.4; }
  .project-about p+p { margin-top:1rem; }
  .project-gallery { overflow:hidden; padding-bottom:clamp(7rem,12vw,12rem); }
  .project-gallery__track { display:flex; gap:clamp(1.5rem,3vw,3rem); overflow-x:auto; padding:1rem 0 4rem clamp(18rem,29vw,32rem); scroll-padding-left:clamp(18rem,29vw,32rem); scroll-snap-type:x mandatory; scrollbar-width:none; }
  .project-gallery__track::-webkit-scrollbar { display:none; }
  .project-visual { position:relative; min-width:clamp(27rem,45vw,43rem); aspect-ratio:1.72/1; overflow:hidden; border:0; border-radius:1.25rem; box-shadow:0 24px 46px rgba(12,39,24,.09); cursor:zoom-in; scroll-snap-align:start; backface-visibility:hidden; }
  .project-visual--green { background:linear-gradient(145deg,#e4eee6,#f9fbf9); }
  .project-visual--blue { background:linear-gradient(145deg,#dce7eb,#fafcfd); }
  .project-visual--sand { background:linear-gradient(145deg,#d9d4c8,#f7f5ef); }
  .project-visual>img { position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; }
  .project-visual>span,.lightbox__fallback { position:absolute; right:.7rem; bottom:-2.7rem; color:rgba(255,255,255,.55); font-family:var(--font-display); font-size:clamp(7rem,16vw,15rem); font-weight:700; letter-spacing:-.08em; }
  .project-skills { padding:0 var(--gutter) clamp(8rem,13vw,13rem); }
  .project-skills>h2 { margin-bottom:clamp(2rem,4vw,4rem); color:var(--green); font-family:var(--font-display); font-size:clamp(2.8rem,5.6vw,5.7rem); font-weight:650; letter-spacing:-.045em; line-height:1; text-transform:uppercase; }
  .project-skills__list { width:min(82%,76rem); margin-left:auto; }
  .project-skills__list a { display:flex; align-items:center; justify-content:space-between; padding:.8rem 0; border-bottom:1px solid rgba(8,11,9,.4); color:var(--ink); font-family:var(--font-display); font-size:clamp(2rem,4.5vw,4.3rem); font-weight:550; letter-spacing:-.04em; line-height:1.08; text-decoration:none; text-transform:uppercase; transition:color .25s ease,padding .3s ease; }
  .project-skills__list a:hover { padding-right:.5rem; padding-left:.5rem; color:var(--green); }
  .project-skills__list a span:last-child { font-size:.45em; }
  .project-skills__empty { color:rgba(8,11,9,.58); }
  .next-project { display:flex; min-height:24rem; align-items:center; justify-content:space-between; gap:2rem; padding:clamp(3rem,5vw,5.5rem) var(--gutter); color:white; background:#3fa456; text-decoration:none; transition:background .35s ease; }
  .next-project:hover { background:#2f9147; }
  .next-project small { display:block; margin-bottom:.4rem; font-size:.75rem; font-weight:600; text-transform:uppercase; }
  .next-project strong { display:block; overflow-wrap:anywhere; font-family:var(--font-display); font-size:clamp(4.5rem,9vw,8.5rem); letter-spacing:-.055em; line-height:.9; text-transform:uppercase; }
  .next-project__arrow { flex:0 0 auto; font-size:clamp(3.5rem,7vw,6.5rem); font-weight:400; line-height:1; transition:transform .35s ease; }
  .next-project:hover .next-project__arrow { transform:translate(.4rem,-.4rem); }
  .lightbox { position:fixed; inset:0; width:100vw; max-width:none; height:100dvh; max-height:none; margin:0; padding:clamp(1rem,4vw,4rem); border:0; background:transparent; color:white; overflow:hidden; }
  .lightbox[open] { display:grid; align-content:center; justify-items:center; gap:1rem; }
  .lightbox::backdrop { background:rgba(4,8,5,.88); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); }
  .lightbox__visual { position:relative; width:min(78vw,75rem); max-width:calc(100vw - 10rem); max-height:calc(100dvh - 10rem); aspect-ratio:1.72/1; overflow:hidden; border-radius:1.25rem; }
  .lightbox__image { display:block; width:100%; height:100%; object-fit:contain; background:rgba(244,248,245,.96); }
  .lightbox__close { position:fixed; z-index:2; top:1.5rem; right:2rem; display:grid; width:3rem; height:3rem; place-items:center; border:0; border-radius:50%; color:var(--ink); background:white; font-size:2rem; line-height:1; cursor:pointer; }
  .lightbox__previous,.lightbox__next { position:fixed; z-index:2; top:50%; width:3.5rem; height:3.5rem; transform:translateY(-50%); border:0; border-radius:50%; color:var(--ink); background:white; font-size:1.5rem; cursor:pointer; }
  .lightbox__previous { left:2rem; }
  .lightbox__next { right:2rem; }
  .lightbox__caption { margin:0; text-align:center; }

  @media (max-width:760px) {
    .project-nav { top:.9rem; width:calc(100% - 1.5rem); }
    .project-nav a { width:100%; }
    .project-intro { min-height:47rem; grid-template-columns:1fr; gap:4rem; padding-top:7.5rem; }
    .project-title-wrap h1 { font-size:clamp(3rem,15vw,5rem); }
    .project-about { align-self:start; margin-top:0; }
    .project-gallery__track { padding-left:var(--gutter); scroll-padding-left:var(--gutter); }
    .project-visual { min-width:84vw; }
    .project-skills__list { width:100%; }
    .next-project { min-height:18rem; }
    .next-project strong { font-size:clamp(3.2rem,14vw,5.2rem); }
    .lightbox { padding:1rem; }
    .lightbox[open] { grid-template-columns:3rem minmax(0,1fr) 3rem; grid-template-rows:minmax(0,1fr) auto; gap:1rem .75rem; }
    .lightbox__visual { width:100%; max-width:none; max-height:calc(100dvh - 7rem); aspect-ratio:auto; grid-column:1 / -1; grid-row:1; border-radius:1rem; }
    .lightbox__previous,.lightbox__next { position:static; width:3rem; height:3rem; transform:none; font-size:1.25rem; }
    .lightbox__previous { grid-column:1; grid-row:2; }
    .lightbox__next { grid-column:3; grid-row:2; }
    .lightbox__caption { grid-column:2; grid-row:2; align-self:center; font-size:.9rem; line-height:1.25; }
    .lightbox__close { top:.75rem; right:.75rem; width:2.75rem; height:2.75rem; }
  }
</style>
